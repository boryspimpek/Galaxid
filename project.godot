; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GALAXID FREE"
run/main_scene="res://scenes/world/World.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
config/icon="res://assets/icon.svg"

[audio]

buses/default_bus_layout="uid://46bi8dsn4fu5"

[autoload]

DataManager="*res://scripts/core/DataManager.gd"
PlayerSetup="*res://scripts/core/PlayerSetup.gd"
GameConstants="*res://scripts/core/GameConstants.gd"
SoundManager="*res://scripts/managers/SoundManager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=800
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=30
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_2d=2
